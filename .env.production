# SignalForge — Production Environment Template
# Copy to .env and fill in all required values before deploying.
# NEVER commit this file with real secrets.

# ── Core ──────────────────────────────────────────────────────────────────────
SIGNALFORGE_ENV=production

# ── Auth (Phase 6U) ──────────────────────────────────────────────────────────
# Set to true to enforce JWT authentication on protected endpoints
SIGNALFORGE_AUTH_ENABLED=true

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SIGNALFORGE_JWT_SECRET=CHANGE_ME_generate_with_secrets_token_hex_32

# Token expiry in hours (default 24)
SIGNALFORGE_JWT_EXPIRY_HOURS=24

# Generate with: python3 -c "import secrets; print('sf-' + secrets.token_hex(24))"
SIGNALFORGE_API_KEY=CHANGE_ME_generate_with_secrets_token_hex_24

# ── Rate limiting (Phase 6U) ──────────────────────────────────────────────────
SIGNALFORGE_RATE_LIMIT_ENABLED=true

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Use an Atlas connection string or a secured self-hosted instance
MONGO_URI=mongodb://mongo:27017/signalforge
# For Atlas: MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/signalforge

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── AI integrations ───────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GPT_AGENT_ENABLED=false

# ── External data sources ─────────────────────────────────────────────────────
LINKEDIN_COOKIE=
X_API_KEY=
APIFY_TOKEN=
SERPAPI_KEY=

# ── ComfyUI / rendering ───────────────────────────────────────────────────────
COMFYUI_ENABLED=false
COMFYUI_BASE_URL=http://comfyui:8188
COMFY_CLOUD_ENABLED=false
COMFY_CLOUD_API_KEY=

# ── Media processing ──────────────────────────────────────────────────────────
FFMPEG_ENABLED=true
FFMPEG_OUTPUT_DIR=/tmp/signalforge_renders
YTDLP_ENABLED=false
YTDLP_OUTPUT_DIR=/tmp/signalforge_downloads
YTDLP_MAX_DURATION_SECONDS=7200
YTDLP_ALLOWED_DOMAINS=youtube.com,youtu.be

# ── Whisper transcription ─────────────────────────────────────────────────────
TRANSCRIPT_PROVIDER=stub
TRANSCRIPT_LIVE_ENABLED=false
WHISPER_MODEL=base
AUTO_SCORE_SNIPPETS=false
SNIPPET_SCORE_THRESHOLD=6

# ── Vault ─────────────────────────────────────────────────────────────────────
VAULT_PATH=/vault
PYTHONPATH=/app
